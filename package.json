{
  "name": "gallery-sorter-by-date",
  "version": "1.0.0",
  "description": "A Node.js CLI tool to organize images and videos into date-based folders",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:ts && npm run build:native",
    "build:ts": "tsc",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "keywords": [
    "gallery",
    "photo",
    "video",
    "organizer",
    "exif",
    "metadata",
    "date-fns"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "date-fns": "^3.6.0",
    "exifreader": "^4.14.1",
    "fluent-ffmpeg": "^2.1.2",
    "glob": "^10.3.10",
    "ora": "^5.4.1",
    "p-limit": "^3.1.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
